# Copy to .env and fill in. .env is gitignored and must never be committed.

# Anthropic API key for the LLM judge. Only needed to capture or refresh real
# judge calls. Replay mode and the seeded demo never read this.
ANTHROPIC_API_KEY=

# Default judge model. Sonnet-class for cost. Configurable per rubric.
AGENTPROBE_JUDGE_MODEL=claude-sonnet-4-6

# Bearer token sent to your agent's HTTP endpoint during live capture. Only the
# HTTP adapter reads this, and only in record mode.
AGENT_BEARER_TOKEN=

# Comma separated allowlist of hosts the HTTP adapter may contact during live
# capture. A request to any other host is refused before it leaves the process.
AGENT_ENDPOINT_ALLOWLIST=localhost,127.0.0.1

# Path to the SQLite database core writes runs to. Defaults to ./data/agentprobe.db
AGENTPROBE_DB_PATH=./data/agentprobe.db
