{
  "name": "@agentprobe/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Command line for AgentProbe: record cassettes, replay suites, set a baseline, and gate CI on regressions.",
  "type": "module",
  "bin": {
    "agentprobe": "./dist/index.js"
  },
  "main": "./dist/config.js",
  "types": "./dist/config.d.ts",
  "exports": {
    ".": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@agentprobe/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
